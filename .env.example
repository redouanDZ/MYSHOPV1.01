# ==============================================================================
# MYSHOP - ملف إعدادات البيئة النموذجية (Environment Configuration Template)
# ==============================================================================
# ملاحظة هامة: لا تضع أي أسرار حقيقية في هذا الملف.
# انسخ هذا الملف إلى .env وضع فيه بياناتك الحقيقية:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. إعدادات الخادم العامة (Core Server Settings)
# ------------------------------------------------------------------------------
# [إلزامي] بيئة التشغيل: 'production' للإنتاج أو 'development' للتطوير المحلي
NODE_ENV=production

# [اختياري] المنفذ الذي يستمع عليه الخادم (الافتراضي: 3000)
PORT=3000

# [اختياري / موصى به] الرابط الكامل لنطاق المتجر (بدون شرطة مائلة في النهاية)
BASE_URL=https://shop.example.dz

# [اختياري] نطاقات CORS المسموحة مفصولة بفاصلة (الافتراضي: localhost و 127.0.0.1)
ALLOWED_ORIGINS=https://shop.example.dz

# ------------------------------------------------------------------------------
# 2. إعدادات قاعدة البيانات (MySQL 8.0 Database)
# ------------------------------------------------------------------------------
# [إلزامي] عنوان خادم قاعدة البيانات (مثال: 127.0.0.1 أو رابط الخادم السحابي)
DB_HOST=127.0.0.1

# [اختياري] منفذ خادم MySQL (الافتراضي: 3306)
DB_PORT=3306

# [إلزامي] اسم قاعدة البيانات (يجب إنشاؤها مسبقاً بترميز utf8mb4)
DB_NAME=myshop_db

# [إلزامي] اسم مستخدم قاعدة البيانات
DB_USER=myshop_user

# [إلزامي] كلمة مرور قاعدة البيانات
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. مفاتيح الأمان والتشفير (Security & Secrets)
# ------------------------------------------------------------------------------
# [إلزامي] سر تشفير توكنات JWT (يجب أن يكون 32 حرفاً عشوائياً كحد أدنى)
# لتوليد سر قوي من سطر الأوامر:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# [إلزامي] سر تشفير كوكيز الجلسات (يجب أن يكون مختلفاً عن JWT_SECRET ولا يقل عن 32 حرفاً)
COOKIE_SECRET=

# [اختياري] مدة كاش الجلسات في الذاكرة بالملي ثانية (الافتراضي: 30000 = 30 ثانية)
SESSION_CACHE_TTL_MS=30000

# [اختياري] تشغيل سياسة أمان المحتوى في وضع المراقبة فقط: 'true' أو 'false' (الافتراضي: false)
CSP_REPORT_ONLY=false

# ------------------------------------------------------------------------------
# 4. حساب المسؤول الأولي (Initial Administrator Account)
# ------------------------------------------------------------------------------
# [اختياري] يتم إنشاء المدير تلقائياً عند أول تشغيل فقط إذا كان جدول المستخدمين فارغاً
# أو يمكنك تشغيل: npm run create-admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 5. بوابة الدفع الإلكتروني (Chargily Pay V2)
# ------------------------------------------------------------------------------
# [اختياري] وضع البوابة: 'test' للتجربة أو 'live' للإنتاج الحقيقي
CHARGILY_MODE=test

# [اختياري] المفتاح العام من لوحة تحكم Chargily Pay
CHARGILY_PUBLIC_KEY=

# [اختياري] المفتاح السري من لوحة تحكم Chargily Pay
CHARGILY_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. التخزين السحابي للصور والوسائط (Cloud Media Storage)
# ------------------------------------------------------------------------------
# موصى به للإنتاج عند استخدام استضافات بقرص تخزين مؤقت (مثل Render أو Railway)
# [اختياري] بيانات حساب Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=myshop

# [اختياري] بديل: تخزين متوافق مع Amazon S3 أو Cloudflare R2
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# 7. هوية ومعلومات المتجر (Store Identity & Branding)
# ------------------------------------------------------------------------------
# [اختياري] يمكن أيضاً تعديلها لاحقاً من لوحة تحكم الإدارة
STORE_NAME=MYSHOP
STORE_TAGLINE=متجرك الموثوق للتسوق في الجزائر
STORE_PHONE=0550 00 00 00
STORE_EMAIL=contact@myshop.dz
STORE_ADDRESS=الجزائر العاصمة، الجزائر
STORE_LOGO_URL=/images/logo.png
CURRENCY_SYMBOL=دج
CURRENCY_CODE=DZD

# ------------------------------------------------------------------------------
# 8. إعدادات خادم البريد (SMTP Email Service)
# ------------------------------------------------------------------------------
# [اختياري] لإرسال فواتير الطلبات وتنبيهات الحسابات
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# [اختياري] فرض تأكيد البريد الإلكتروني لتفعيل الحسابات: 'true' أو 'false'
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# 9. التنبيهات الفورية وبوت تيليجرام (Telegram Alerts)
# ------------------------------------------------------------------------------
# [اختياري] إرسال إشعارات فورية بكل طلب جديد إلى قناتك أو حسابك
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 10. تسجيل الدخول عبر Google (Google OAuth 2.0)
# ------------------------------------------------------------------------------
# [اختياري] معرف العميل Client ID من Google Cloud Console
GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 11. إعدادات بيئة التطوير والاختبار فقط (Development & Testing Only)
# ------------------------------------------------------------------------------
# [اختياري] تفعيل وضع الذاكرة عند تعذر الاتصال بـ MySQL (ممنوع في الإنتاج)
DEMO_MODE=false

# ---- Security tuning (optional) ----
# Enforce the strict Content-Security-Policy (no inline scripts). Leave unset first: the strict
# policy is then only REPORTED (browser console), and the compatible policy stays enforced.
# CSP_STRICT=true
# Rate limits per IP per 15 minutes in production (defaults shown). Raise temporarily for reviews/demos.
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_TRACK_MAX=20
# RATE_LIMIT_API_GET_MAX=600
# RATE_LIMIT_API_WRITE_MAX=200

