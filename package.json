{
  "name": "myshop",
  "version": "1.0.1",
  "description": "مشروع متجر إلكتروني احترافي مصمم لتقديم تجربة تسوق سلسة وسهلة للعملاء. المتجر يدعم اللغة العربية بالكامل مع تصميم متجاوب يعمل على جميع الأجهزة.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "node scripts/build-css.js",
    "build:sw": "node scripts/build-sw-hash.js",
    "build": "npm run build:css && node scripts/build-sw-hash.js && node scripts/validate.js",
    "lint": "eslint server.js src/ database/ test/ scripts/",
    "dev:node": "node server.js",
    "migrate": "node database/migrate.js",
    "db:reset": "node database/reset.js",
    "create-admin": "node src/scripts/create-admin.js",
    "seed:demo": "node scripts/seedDemoData.js",
    "check:i18n": "node scripts/check-i18n.js",
    "test": "node --test test/all.test.js"
  },
  "keywords": [
    "ecommerce",
    "arabic",
    "store",
    "nodejs",
    "mysql"
  ],
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^6.11.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.14.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "lightningcss": "^1.33.0",
    "nodemon": "^3.1.14"
  }
}
